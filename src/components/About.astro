---
import SectionHead from './SectionHead.astro';
import TilePanel from './TilePanel.astro';
import { copy, toLang } from '../i18n/utils';

const c = copy(toLang(Astro.currentLocale));

// Drawn strictly from the prose below — no dates, because none are claimed there.
const track = [
	{ ...c.about.track.now, where: 'CaixaBank · AI Innovation', tint: 'bg-anil' },
	{ ...c.about.track.before, where: 'NTT DATA · Softtek', tint: 'bg-almagra' },
	{ ...c.about.track.study, where: 'Universitat Oberta de Catalunya', tint: 'bg-verde' },
];
---

<section id="about" class="relative px-6 py-16 sm:px-10 sm:py-20">
	<div class="mx-auto max-w-280">
		<SectionHead index="02" eyebrow={c.about.eyebrow} title={c.about.title} />

		<div class="grid grid-cols-1 gap-10 lg:grid-cols-[1fr_340px] lg:gap-16">
			<div class="js-reveal max-w-160">
				<p class="border-l-2 border-almagra pl-5 text-lg leading-relaxed text-tinta sm:text-xl">
					{c.about.lead}
				</p>
				<p class="mt-6 pl-5 text-base leading-relaxed text-muted">
					{c.about.body}
				</p>
			</div>

			<div class="js-reveal panel flex flex-col border border-linea bg-cal">
				<div class="cenefa junquillo h-4.5 shrink-0" aria-hidden="true"></div>
				<ul class="px-5 py-2">
					{track.map((t) => (
						<li class="border-b border-linea py-4 last:border-b-0">
							<span class="flex items-center gap-2.5">
								<span class={`h-2 w-2 shrink-0 rotate-45 ${t.tint}`} aria-hidden="true"></span>
								<span class="font-mono text-[11px] tracking-[0.1em] text-faint uppercase">
									{t.when}
								</span>
							</span>
							<p class="mt-1.5 text-[15px] font-semibold text-tinta">{t.where}</p>
							<p class="mt-0.5 font-mono text-[12.5px] text-faint">{t.what}</p>
						</li>
					))}
				</ul>
				<TilePanel
					class="mt-auto h-20 border-t border-linea"
					ground="bg-cal-2"
					star="bg-anil/35"
					cross="bg-cal"
					glaze={false}
					tile={44}
				/>
			</div>
		</div>
	</div>
</section>
