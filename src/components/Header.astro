---
const links = [
	{ href: '#about', label: 'Sobre mi' },
	{ href: '#projects', label: 'Proyectos' },
	{ href: '#contact', label: 'Contacto' },
];
---

<header class="sticky top-0 z-50 border-b border-neutral-800 bg-neutral-950/80 backdrop-blur">
	<nav class="mx-auto flex max-w-4xl items-center justify-between px-6 py-4">
		<a href="#" class="font-semibold tracking-tight">Rafael Galvez</a>
		<ul class="flex gap-6 text-sm text-neutral-400">
			{links.map((link) => (
				<li>
					<a href={link.href} class="transition-colors hover:text-neutral-100">{link.label}</a>
				</li>
			))}
		</ul>
	</nav>
</header>
