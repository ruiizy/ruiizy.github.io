---
import TilePanel from './TilePanel.astro';

const meta = [
	{ k: 'role', v: 'AI Engineer', tint: 'bg-anil' },
	{ k: 'at', v: 'CaixaBank · AI Innovation', tint: 'bg-almagra' },
];
---

<section class="relative overflow-hidden px-6 pt-14 pb-16 sm:px-10 sm:pt-24 sm:pb-20">
	<!-- The wall runs off the edge of the frame the way a real alicatado does. -->
	<div class="absolute inset-y-0 right-0 hidden w-[38vw] max-w-140 lg:block" aria-hidden="true">
		<div class="cenefa junquillo absolute inset-y-0 left-0 z-10 w-3.5"></div>
		<div class="absolute inset-0">
			<TilePanel
				class="h-full w-full"
				tile={82}
				star="bg-anil"
				starAlt="bg-anil-2"
				cross="bg-cal"
				crossAlt="bg-cal-2"
			/>
		</div>
	</div>

	<div class="relative mx-auto max-w-280">
		<div class="lg:max-w-[60%]">
			<p class="js-hero-eyebrow mb-6 flex items-center gap-3 font-mono text-[12.5px] text-almagra">
				<span class="h-px w-10 bg-almagra"></span>
				hola, soy
			</p>

			<h1 class="font-display font-black uppercase [font-stretch:85%]">
				<span class="js-hero-line1 block text-[clamp(3rem,9vw,7rem)] leading-[0.84] tracking-[-0.03em]">
					Rafael
				</span>
				<span
					class="js-hero-line2 mt-1.5 block text-[clamp(3rem,9vw,7rem)] leading-[0.84] tracking-[-0.03em] text-almagra"
				>
					Galvez Ruiz
				</span>
			</h1>

			<div class="js-hero-role mt-10 max-w-165">
				<div class="cenefa junquillo h-4.5" aria-hidden="true"></div>
				<dl class="grid grid-cols-1 border-x border-b border-linea bg-cal/70 sm:grid-cols-2">
					{meta.map((m) => (
						<div class="border-b border-linea px-4 py-3.5 last:border-b-0 sm:border-r sm:border-b-0 sm:last:border-r-0">
							<span class="flex items-center gap-2">
								<span class={`h-2 w-2 rotate-45 ${m.tint}`}></span>
								<dt class="font-mono text-[11px] tracking-[0.1em] text-faint uppercase">{m.k}</dt>
							</span>
							<dd class="mt-1.5 text-[15px] font-semibold text-tinta">{m.v}</dd>
						</div>
					))}
				</dl>
			</div>

			<p class="js-hero-quote mt-8 max-w-125 text-base leading-relaxed text-muted sm:text-lg">
				I build the bridge between high-performance frontend architectures and production-grade
				agentic AI — designing stateful multi-agent workflows with LangGraph, LangChain and MCP.
			</p>

			<a
				href="#projects"
				class="js-hero-cta panel panel-lift group mt-10 inline-flex items-stretch border border-tinta bg-cal font-mono text-[13px]"
			>
				<span class="bg-tinta px-5 py-3.5 text-cal transition-colors duration-200 group-hover:bg-anil">
					ver trabajo
				</span>
				<span class="flex w-12 items-center justify-center transition-colors duration-200 group-hover:bg-cal-2">
					<svg
						width="15"
						height="15"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="transition-transform duration-200 group-hover:translate-x-0.5"
					>
						<path d="M5 12h14"></path>
						<path d="M13 6l6 6-6 6"></path>
					</svg>
				</span>
			</a>
		</div>
	</div>
</section>
