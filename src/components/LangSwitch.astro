---
import { languages, type Lang } from '../i18n/ui';
import { copy, homeOf, toLang } from '../i18n/utils';

interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;

const lang = toLang(Astro.currentLocale);
const c = copy(lang);
const order: Lang[] = ['en', 'es'];
---

<div class={`flex border border-linea ${className}`} role="group" aria-label={c.nav.language}>
	{order.map((code) => (
		<a
			href={homeOf(code)}
			hreflang={code}
			lang={code}
			title={languages[code]}
			data-lang-pick={code}
			aria-current={code === lang ? 'true' : undefined}
			class:list={[
				'px-2 py-1 font-mono text-[11px] tracking-[0.08em] uppercase transition-colors',
				code === lang ? 'bg-anil text-cal' : 'text-muted hover:bg-cal-2 hover:text-anil',
			]}
		>
			{code}
		</a>
	))}
</div>

<script>
	// Picking a language pins it, so the system-language check in Layout.astro
	// stops overriding the visitor on every later visit.
	document.querySelectorAll<HTMLAnchorElement>('[data-lang-pick]').forEach((el) => {
		el.addEventListener('click', () => {
			try {
				localStorage.setItem('lang', el.dataset.langPick!);
			} catch (e) {
				/* no storage: the choice just won't outlive the navigation */
			}
		});
	});
</script>
