---
import { posts } from '../data/posts';
---

<section id="posts" class="relative overflow-hidden border-t border-line px-8 py-16 sm:py-18">
	<span
		class="ghost-num pointer-events-none absolute -top-5 -left-2 -z-10 select-none font-serif text-[200px] leading-none italic text-transparent opacity-10 [-webkit-text-stroke:1px_currentColor]"
	>
		04
	</span>
	<div class="relative mx-auto max-w-[1080px]">
		<p class="js-reveal mb-2 text-[13px] font-semibold tracking-[0.14em] text-accent uppercase">Journal</p>
		<h2 class="js-reveal mb-9 font-serif text-4xl font-normal italic">Posts</h2>
		<div class="flex flex-col">
			{posts.map((post) => (
				<a
					href={post.link ?? '#'}
					class="js-reveal group grid grid-cols-[140px_1fr_auto] items-start gap-6 border-b border-line py-[26px]"
				>
					<span class="pt-1.5 text-[13px] font-semibold tracking-wide text-faint uppercase">{post.date}</span>
					<div class="flex flex-col gap-2">
						<h3 class="font-serif text-2xl font-normal transition-colors duration-200 group-hover:text-accent">
							{post.title}
						</h3>
						<p class="max-w-[480px] text-sm leading-relaxed text-faint italic">{post.excerpt}</p>
					</div>
					<span class="mt-1.5 flex h-6 w-6 items-center justify-center rounded-full border border-current transition-colors duration-200 group-hover:border-accent group-hover:bg-accent">
						<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-colors duration-200 group-hover:stroke-cream">
							<path d="M7 17L17 7" /><path d="M7 7h10v10" />
						</svg>
					</span>
				</a>
			))}
		</div>
	</div>
</section>
