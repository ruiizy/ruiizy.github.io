---
import type { Project } from '../data/projects';

interface Props {
	project: Project;
	index: number;
}

const { project, index } = Astro.props;
const num = String(index).padStart(2, '0');
---

<article class="js-reveal group grid grid-cols-[32px_1fr] items-start gap-x-4 gap-y-4 border-b border-cream/15 py-7 sm:grid-cols-[56px_1fr_auto] sm:gap-x-6">
	<span class="font-serif text-lg text-accent italic">{num}</span>
	<div class="flex flex-col gap-2.5">
		<h3 class="font-serif text-2xl font-normal transition-colors duration-200 group-hover:text-accent sm:text-3xl">
			{project.title}
		</h3>
		<p class="max-w-115 text-sm leading-relaxed text-cream/75">
			{project.description}
		</p>
		<div class="mt-1.5 flex flex-wrap gap-2.5">
			{project.tags.map((tag) => (
				<span class="rounded-full border border-cream/25 px-2.5 py-1 text-[11px] font-semibold tracking-wide text-cream/75 uppercase">
					{tag}
				</span>
			))}
		</div>
	</div>
	<div class="col-span-2 flex flex-row items-center gap-5 pl-11 sm:col-span-1 sm:flex-col sm:items-end sm:gap-3 sm:pt-1.5 sm:pl-0">
		{project.link && (
			<a href={project.link} class="flex items-center gap-2 text-sm font-medium">
				View
				<span class="flex h-6 w-6 items-center justify-center rounded-full border border-current transition-colors duration-200 group-hover:border-accent group-hover:bg-accent">
					<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-colors duration-200 group-hover:stroke-cream">
						<path d="M7 17L17 7" /><path d="M7 7h10v10" />
					</svg>
				</span>
			</a>
		)}
		{project.repo && (
			<a href={project.repo} class="flex items-center gap-2 text-sm font-medium">
				Code
				<span class="flex h-6 w-6 items-center justify-center rounded-full border border-current transition-colors duration-200 group-hover:border-accent group-hover:bg-accent">
					<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-colors duration-200 group-hover:stroke-cream">
						<path d="M7 17L17 7" /><path d="M7 7h10v10" />
					</svg>
				</span>
			</a>
		)}
	</div>
</article>
