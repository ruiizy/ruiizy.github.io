---
import type { Project } from '../data/projects';
import { copy, toLang } from '../i18n/utils';

interface Props {
	project: Project;
	index: number;
}

const { project, index } = Astro.props;
const num = String(index).padStart(2, '0');

const lang = toLang(Astro.currentLocale);
const c = copy(lang);

const links = [
	project.link ? { href: project.link, label: c.projects.view } : null,
	project.repo ? { href: project.repo, label: c.projects.code } : null,
].filter(Boolean) as { href: string; label: string }[];
---

<article
	class="js-reveal group grid grid-cols-[44px_1fr] items-start gap-x-5 gap-y-5 border-b border-cal/15 py-8 sm:grid-cols-[72px_1fr_auto] sm:gap-x-8"
>
	<span
		class="flex h-11 w-11 items-center justify-center border border-albero/45 bg-albero/10 font-mono text-[13px] text-albero transition-colors duration-200 group-hover:border-albero group-hover:bg-albero group-hover:text-tinta"
	>
		{num}
	</span>

	<div class="flex flex-col gap-3">
		<h3
			class="font-display text-2xl font-black tracking-[-0.02em] uppercase transition-colors duration-200 [font-stretch:85%] group-hover:text-albero sm:text-[34px]"
		>
			{project.title}
		</h3>
		<p class="max-w-125 text-[15px] leading-relaxed text-cal/75">{project.description[lang]}</p>
		<ul class="mt-1 flex flex-wrap gap-2">
			{project.tags.map((tag) => (
				<li class="border border-cal/25 bg-cal/5 px-2.5 py-1 font-mono text-[11.5px] text-cal/80">
					{tag}
				</li>
			))}
		</ul>
	</div>

	<div class="col-span-2 flex flex-row gap-3 pl-16 sm:col-span-1 sm:flex-col sm:items-end sm:pt-1 sm:pl-0">
		{links.map((l) => (
			<a
				href={l.href}
				target="_blank"
				rel="noopener noreferrer"
				class="flex items-center gap-2 border border-cal/30 bg-tinta px-3.5 py-2 font-mono text-[12.5px] transition-colors duration-200 hover:border-albero hover:bg-albero hover:text-tinta"
			>
				{l.label}
				<svg
					width="12"
					height="12"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<path d="M7 17L17 7"></path>
					<path d="M7 7h10v10"></path>
				</svg>
			</a>
		))}
	</div>
</article>
