---
import { projects } from '../data/projects';
import ProjectCard from './ProjectCard.astro';
import SectionHead from './SectionHead.astro';
import TilePanel from './TilePanel.astro';
import { copy, toLang } from '../i18n/utils';

const c = copy(toLang(Astro.currentLocale));
---

<section id="projects" class="relative overflow-hidden bg-tinta text-cal">
	<div class="cenefa junquillo h-4.5" aria-hidden="true"></div>

	<!-- A panel of the wall, cut off square at its edge the way alicatado is. -->
	<div class="absolute inset-y-0 right-0 hidden w-[26vw] max-w-96 border-l border-albero/30 lg:block">
		<TilePanel
			class="h-full w-full"
			ground="bg-tinta"
			star="bg-albero opacity-[0.11]"
			cross="bg-albero opacity-[0.05]"
			relief={false}
			lace="bg-albero"
			laceOpacity="opacity-[0.20]"
			glaze={false}
			tile={92}
		/>
	</div>

	<div class="relative mx-auto max-w-280 px-6 py-16 sm:px-10 sm:py-20">
		<SectionHead index="04" eyebrow={c.projects.eyebrow} title={c.projects.title} tone="dark" />
		<div class="border-t border-cal/15">
			{projects.map((project, index) => <ProjectCard project={project} index={index + 1} />)}
		</div>
	</div>

	<div class="cenefa junquillo h-4.5" aria-hidden="true"></div>
</section>
