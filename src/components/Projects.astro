---
import { projects } from '../data/projects';
import ProjectCard from './ProjectCard.astro';
---

<section id="projects" class="relative left-1/2 right-1/2 -z-0 -mx-[50vw] w-screen overflow-hidden bg-ink px-8 py-16 text-cream sm:py-18">
	<span
		class="ghost-num pointer-events-none absolute -top-5 -right-2 -z-10 select-none font-serif text-[200px] leading-none italic text-transparent opacity-10 text-cream [-webkit-text-stroke:1px_currentColor]"
	>
		04
	</span>
	<div class="relative mx-auto max-w-[1080px]">
		<p class="js-reveal mb-2 text-[13px] font-semibold tracking-[0.14em] text-accent uppercase">Work</p>
		<h2 class="js-reveal mb-9 font-serif text-4xl font-normal italic">Projects</h2>
		<div class="flex flex-col">
			{projects.map((project, index) => (
				<ProjectCard project={project} index={index + 1} />
			))}
		</div>
	</div>
</section>
