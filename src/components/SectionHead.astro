---
interface Props {
	index: string;
	eyebrow: string;
	title: string;
	tone?: 'light' | 'dark';
}

const { index, eyebrow, title, tone = 'light' } = Astro.props;

const STAR =
	'M50 16L59.96 25.96L74.04 25.96L74.04 40.04L84 50L74.04 59.96L74.04 74.04L59.96 74.04L50 84L40.04 74.04L25.96 74.04L25.96 59.96L16 50L25.96 40.04L25.96 25.96L40.04 25.96Z';

// One tile, set the same way as the wordmark, marks every section.
const ground = tone === 'dark' ? 'var(--color-albero)' : 'var(--color-anil)';
const knockout = tone === 'dark' ? 'var(--color-tinta)' : 'var(--color-cal)';
const label = tone === 'dark' ? 'text-cal/70' : 'text-faint';
const rule = tone === 'dark' ? 'bg-cal/20' : 'bg-linea';
---

<div class="js-reveal mb-10">
	<div class="mb-5 flex items-center gap-3.5">
		<svg viewBox="0 0 100 100" class="panel h-5 w-5 shrink-0" aria-hidden="true">
			<rect width="100" height="100" fill={ground}></rect>
			<path d={STAR} fill={knockout}></path>
		</svg>
		<span class={`font-mono text-[12px] tracking-[0.1em] uppercase ${label}`}>
			{index} / {eyebrow}
		</span>
		<span class={`h-px flex-1 ${rule}`}></span>
	</div>
	<h2
		class="font-display text-[clamp(2.25rem,6vw,3.75rem)] leading-[0.9] font-black tracking-[-0.025em] uppercase [font-stretch:85%]"
	>
		{title}
	</h2>
</div>
