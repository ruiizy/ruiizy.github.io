---
import SectionHead from './SectionHead.astro';
import TilePanel from './TilePanel.astro';

const groups = [
	{
		label: 'AI / Agents',
		tint: 'bg-anil',
		soft: 'bg-anil-2/55',
		text: 'text-anil',
		items: ['Python', 'LangChain', 'LangGraph', 'MCP', 'Qdrant', 'LlamaIndex'],
	},
	{
		label: 'Frontend',
		tint: 'bg-almagra',
		soft: 'bg-almagra/35',
		text: 'text-almagra',
		items: ['React', 'TypeScript', 'Angular'],
	},
	{
		label: 'Backend',
		tint: 'bg-verde',
		soft: 'bg-verde/35',
		text: 'text-verde',
		items: ['Java', 'Spring Boot'],
	},
];
---

<section id="stack" class="wash relative border-t border-linea px-6 py-16 sm:px-10 sm:py-20">
	<div class="mx-auto max-w-280">
		<SectionHead index="03" eyebrow="toolbox" title="Stack" />

		<div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
			{groups.map((group) => (
				<div class="js-reveal panel panel-lift flex flex-col border border-linea bg-cal">
					<div
						class={`tile-zellij junquillo h-9 shrink-0 ${group.tint}`}
						style="--tile: 36px"
						aria-hidden="true"
					></div>

					<div class="px-5 pt-5 pb-4">
						<p class={`font-mono text-[11.5px] tracking-[0.12em] uppercase ${group.text}`}>
							{group.label}
						</p>
						<ul class="mt-4 flex flex-col">
							{group.items.map((item) => (
								<li class="flex items-center gap-3 border-b border-linea py-2.5 last:border-b-0">
									<span class={`h-2 w-2 shrink-0 rotate-45 ${group.tint}`} aria-hidden="true"></span>
									<span class="text-[15px] font-semibold text-tinta">{item}</span>
								</li>
							))}
						</ul>
					</div>

					<!-- Dead space at the foot of a short list becomes wall, not a void. -->
					<TilePanel
						class="mt-auto h-24 border-t border-linea"
						ground="bg-cal-2"
						star={group.soft}
						cross="bg-cal"
						glaze={false}
						tile={44}
					/>
				</div>
			))}
		</div>
	</div>
</section>
