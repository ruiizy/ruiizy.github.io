---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Rafael Galvez Ruiz — AI Engineer',
	description = 'Rafael Galvez Ruiz — AI Engineer in Sevilla. Multi-agent systems with LangGraph, LangChain and MCP.',
} = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#faf6ef" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=JetBrains+Mono:wght@400..600&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body class="relative bg-cal font-sans text-tinta antialiased">
		<!-- Lacería line-work washed over the whole wall, in place of film grain. -->
		<div
			class="tile-lace pointer-events-none fixed inset-0 -z-10 bg-albero opacity-[0.13]"
			style="--tile: 84px"
			aria-hidden="true"
		>
		</div>
		<slot />
	</body>
</html>
